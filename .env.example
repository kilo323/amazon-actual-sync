# =============================================================================
# Amazon Orders Sync – Bootstrap Environment
#
# All settings (accounts, schedule, etc.) are configured through the web UI
# at http://localhost:8080 after first run.  Only a small number of values
# need to be set here before starting.
# =============================================================================

# -------------------------------------------------------------------------
# OPTIONAL: Port the web UI listens on (host-side).
# Access the UI at http://localhost:${SYNC_WEBAPP_PORT}
# ⚠  Do NOT expose this port publicly without adding authentication via a
#    reverse proxy (nginx, Traefik, Caddy, etc.).
# -------------------------------------------------------------------------
# SYNC_WEBAPP_PORT=8080

# -------------------------------------------------------------------------
# OPTIONAL: Log verbosity for the container.
# Values: DEBUG | INFO | WARNING | ERROR
# -------------------------------------------------------------------------
# LOG_LEVEL=INFO

# -------------------------------------------------------------------------
# HEADLESS FALLBACK (env-var-only mode, no web UI)
# If you prefer not to use the web UI, you can bootstrap accounts via the
# AMAZON_ACCOUNTS variable and restart without the webapp.
# Uncomment and fill in the value below, then run: docker compose run
# --rm amazon-orders python -m app.main
# -------------------------------------------------------------------------
# AMAZON_ACCOUNTS=[{"username":"you@example.com","password":"s3cr3t","label":"personal"}]

# -------------------------------------------------------------------------
# Actual Budget Server connection (used by the Node.js API wrapper)
# -------------------------------------------------------------------------
# ACTUAL_SERVER_URL=http://localhost:5006/
# ACTUAL_SERVER_PASSWORD=changeme

# -------------------------------------------------------------------------
# Actual Budget Web UI port (host-side)
# -------------------------------------------------------------------------
# ACTUAL_WEBAPP_PORT=5006
